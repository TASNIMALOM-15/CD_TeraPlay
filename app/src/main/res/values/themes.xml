<resources>
    <style name="Theme.TeraPlay" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:textColorPrimary">@color/glass_text</item>
        <item name="android:textColorSecondary">@color/glass_text2</item>
        <item name="android:textColorHint">@color/glass_text2</item>
        <item name="colorAccent">#5AC8FA</item>
        <item name="alertDialogTheme">@style/GlassDialog</item>
        <item name="popupMenuStyle">@style/GlassPopupMenu</item>
    </style>

    <style name="GlassDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_dialog_bg</item>
        <item name="android:textColorPrimary">@color/glass_text</item>
        <item name="android:textColorSecondary">@color/glass_text2</item>
        <item name="colorAccent">#5AC8FA</item>
    </style>

    <style name="GlassPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/glass_popup_bg</item>
    </style>

    <!-- round icon button inside a glass pill -->
    <style name="PillIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:tint">@color/glass_icon</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- thin version for the top bars (about 2/3 of PillIcon) -->
    <style name="PillIconSmall" parent="PillIcon">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:padding">6dp</item>
    </style>

    <!-- chips of the player screen: as wide as their text, the row scrolls sideways when needed -->
    <style name="PlayerChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- text chip (used on GlassTextView) -->
    <style name="ActionChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
