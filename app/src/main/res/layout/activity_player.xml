<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.teraplay.app.BackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.teraplay.app.RatioFrameLayout
            android:id="@+id/playerBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000000">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/hud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/badge_bg"
                android:paddingStart="16dp"
                android:paddingTop="9dp"
                android:paddingEnd="16dp"
                android:paddingBottom="9dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </com.teraplay.app.RatioFrameLayout>

        <LinearLayout
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/metaText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <com.teraplay.app.GlassTextView
                        android:id="@+id/favBtn"
                        style="@style/PlayerChip"
                        android:text="@string/s019" />

                    <com.teraplay.app.GlassTextView
                        android:id="@+id/dislikeBtn"
                        style="@style/PlayerChip"
                        android:text="@string/dis_chip" />

                    <com.teraplay.app.GlassTextView
                        android:id="@+id/shareBtn"
                        style="@style/PlayerChip"
                        android:text="@string/s020" />

                    <com.teraplay.app.GlassTextView
                        android:id="@+id/speedBtn"
                        style="@style/PlayerChip"
                        android:text="⏩ 1x" />

                    <com.teraplay.app.GlassTextView
                        android:id="@+id/qualityBtn"
                        style="@style/PlayerChip"
                        android:text="🎞 480p" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="4"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/panelTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp"
                    android:text="@string/s107"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.teraplay.app.GlassLinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <ImageView
                        android:id="@+id/modeList"
                        style="@style/PillIcon"
                        android:contentDescription="List"
                        android:src="@drawable/ic_q_list" />

                    <ImageView
                        android:id="@+id/modeGrid"
                        style="@style/PillIcon"
                        android:contentDescription="Grid"
                        android:src="@drawable/ic_cols2" />

                    <ImageView
                        android:id="@+id/modeMini"
                        style="@style/PillIcon"
                        android:contentDescription="Mini queue"
                        android:src="@drawable/ic_q_mini" />
                </com.teraplay.app.GlassLinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/queueView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
